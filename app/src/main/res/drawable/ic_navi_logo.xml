    android:width="80dp"
    android:height="80dp"
    android:viewportWidth="80"
    android:viewportHeight="80">

    <!-- Background circle -->
    <path
        android:fillColor="#1A5CCC"
        android:pathData="M40,0 A40,40 0 1 1 39.99,0 Z" />

    <!-- Compass ring -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:fillColor="#00000000"
        android:pathData="M40,8 A32,32 0 1 1 39.99,8 Z" />

    <!-- North pointer (white) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,11 L47,38 L40,33 L33,38 Z" />

    <!-- South pointer (light blue) -->
    <path
        android:fillColor="#7EB3FF"
        android:pathData="M40,69 L33,42 L40,47 L47,42 Z" />

    <!-- Center -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,37 A3,3 0 1 1 39.99,37 Z" />

</vector>
