<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:background="@drawable/bg_settings_card"
        android:elevation="1dp">

        <LinearLayout style="@style/SettingsRow">
            <LinearLayout style="@style/SettingsRowTextWrap">
                <TextView style="@style/SettingsRowTitle" android:text="@string/blocked_ads_count"/>
                <TextView android:id="@+id/tvAdRuleCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="12sp"
                    android:textColor="@color/textSecondary"/>
            </LinearLayout>
            <TextView android:id="@+id/tvBlockedAdsCount" style="@style/SettingsRowValue"/>
        </LinearLayout>
        <include layout="@layout/item_divider"/>
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsRowTitle" android:text="@string/about_version"/>
            <TextView android:id="@+id/tvVersion" style="@style/SettingsRowValue"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
