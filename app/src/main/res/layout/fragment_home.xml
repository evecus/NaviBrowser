<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Logo area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="64dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:src="@drawable/ic_navi_logo"
                android:contentDescription="NaviBrowser"
                android:elevation="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="NaviBrowser"
                android:textSize="16sp"
                android:textColor="@color/textSecondary"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <!-- Shortcuts grid (add button is the last item in the adapter) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvShortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="12dp" android:paddingRight="12dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
